<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Carmine.Desktop.App"
             Name="Carmine Workbench"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CarmineWorkbench/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://CarmineWorkbench/Themes/Brand.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://CarmineWorkbench/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
