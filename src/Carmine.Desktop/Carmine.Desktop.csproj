<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Carmine.Desktop</RootNamespace>
    <AssemblyName>CarmineWorkbench</AssemblyName>
    <!-- Shown by Windows as the file description, e.g. in Task Manager. -->
    <AssemblyTitle>Carmine Workbench</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot>true</PublishAot>
    <!-- Avoids a hard dependency on ICU, which minimal Linux installs and AppImage hosts may lack. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Carmine.Core\Carmine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
