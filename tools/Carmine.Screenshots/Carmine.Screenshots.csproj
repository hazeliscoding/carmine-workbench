<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the main window to PNG with Avalonia's headless Skia renderer, in light and dark.
    Argument: the output folder, e.g. docs
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Carmine.Screenshots</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Carmine.Desktop\Carmine.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

</Project>
